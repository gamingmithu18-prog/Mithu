const express = require('express');
const { default: makeWASocket, useMultiFileAuthState, delay } = require('@whiskeysockets/baileys');
const pino = require('pino');
const fs = require('fs');
const app = express();
const PORT = process.env.PORT || 3000;

app.use(express.json());
app.use(express.urlencoded({ extended: true }));

app.get('/', (req,res)=>{
res.send(`<html><head><meta name="viewport" content="width=device-width"><title>MITHU PAIR SITE</title><style>body{background:#111;color:#fff;font-family:sans-serif;text-align:center;padding-top:40px}input{padding:14px;width:260px;border-radius:10px;border:none;font-size:16px}button{padding:14px 22px;background:#25D366;color:#fff;border:none;border-radius:10px;font-weight:bold;font-size:16px;margin-top:10px}</style></head><body><h1>🤖 MITHU MUSIC BOT</h1><h3>Public Pair Site</h3><p>Number eka danna (9477xxxxxxx)</p><form action="/pair" method="GET"><input name="number" placeholder="9477xxxxxxx" required><br><button type="submit">Get Pair Code</button></form><p style="color:#666;margin-top:40px">Bot by MITHU</p></body></html>`);
});

app.get('/pair', async (req,res)=>{
try{
let num=(req.query.number||'').replace(/[^0-9]/g,'');
if(!num) return res.send('Number eka hari na!');
if(!fs.existsSync('./sessions')) fs.mkdirSync('./sessions');
const {state, saveCreds} = await useMultiFileAuthState('./sessions/pair_'+num);
const sock = makeWASocket({auth:state, logger:pino({level:'silent'}), printQRInTerminal:false, browser:['MITHU','Chrome','1.0']});
sock.ev.on('creds.update', saveCreds);
if(!sock.authState.creds.registered){
await delay(2000);
let code = await sock.requestPairingCode(num);
code = code?.match(/.{1,4}/g)?.join('-')||code;
return res.send(`<body style="background:#111;color:#fff;text-align:center;padding-top:60px;font-family:sans-serif"><h1>✅ Your Pair Code</h1><h1 style="color:#25D366;font-size:45px;letter-spacing:3px">${code}</h1><p>WhatsApp > Linked Devices > Link with phone number > Enter this code</p><p style="color:#aaa">Code eka 1min walin expire wenawa!</p><a href="/" style="color:#25D366">Back</a></body>`);
} else {
return res.send('Already paired! Delete sessions folder to pair again.');
}
}catch(e){
console.log(e);
return res.status(500).send('Error: '+e.message);
}
});

app.listen(PORT, ()=> console.log('MITHU Pair Live on '+PORT));
